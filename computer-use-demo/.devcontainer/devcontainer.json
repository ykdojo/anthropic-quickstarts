{
  "name": "Computer Use Demo",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "sourcegraph.amp"
      ]
    }
  },
  "containerEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "forwardPorts": [6080, 5900],
  "portsAttributes": {
    "6080": {
      "label": "noVNC",
      "onAutoForward": "notify"
    },
    "5900": {
      "label": "VNC",
      "onAutoForward": "silent"
    }
  },
  "remoteUser": "computeruse"
}
